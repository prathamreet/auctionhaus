{
  "name": "auctionhaus-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "front",
    "back",
    "packages/simulator"
  ],
  "scripts": {
    "dev:front": "npm run dev --workspace=front",
    "dev:back": "npm run dev --workspace=back",
    "build": "npm run build:back && npm run build:front",
    "build:front": "npm run build --workspace=front",
    "build:back": "npm run build --workspace=back",
    "start:front": "npm run start --workspace=front",
    "start:back": "npm run start --workspace=back",
    "test": "npm run test --workspaces --if-present",
    "test:back": "npm run test --workspace=back",
    "test:front": "npm run test --workspace=front --if-present",
    "lint": "npm run lint:back && npm run lint:front",
    "lint:back": "npm run lint --workspace=back",
    "lint:front": "npm run lint --workspace=front",
    "ci:local": "npm run lint && npm run build:back && npm run test:back",
    "prisma:generate": "npm run prisma:generate --workspace=back",
    "prisma:migrate": "npm run prisma:migrate --workspace=back",
    "prisma:studio": "npm run prisma:studio --workspace=back",
    "db:seed": "npm run db:seed-users --workspace=back",
    "db:seed-demo": "npm run db:seed-demo --workspace=back",
    "db:reset-auctions": "npm run db:clear-auctions --workspace=back",
    "db:prepare-bench": "npm run db:prepare-bench --workspace=back",
    "sim:run": "npm run sim:run --workspace=back",
    "train:fraud": "npm run train:fraud --workspace=back",
    "eval:fraud": "npm run eval:fraud --workspace=back",
    "postinstall": "npm run prisma:generate"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
