# ==============================================================================
# AuctionHaus Monorepo Environment Variables Template
# ==============================================================================
#
# This monorepo uses separate environment files for each service.
# Do NOT copy this file directly to a root .env.
# Instead, create/copy the following .env files in their respective directories:
#
# 1. Backend Service:     back/.env (see back/.env.example)
# 2. Frontend App:        front/.env (see front/.env.example)
# 3. Simulator Package:   packages/simulator/.env (see packages/simulator/.env.example)
#
# Below is a consolidated reference of all variables:

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (back/.env)
# ------------------------------------------------------------------------------
# PORT=5000
# NODE_ENV=development
# DATABASE_URL="postgresql://postgres:password@localhost:5432/auctionhaus"
# JWT_SECRET=your_super_secret_jwt_key_change_in_production
# JWT_EXPIRES_IN=7d
# REDIS_URL=redis://localhost:6379
# FRONTEND_URL=http://localhost:3000
#
# Optional overrides:
# RATE_LIMIT_MAX=1000
# RATE_LIMIT_STRICT_MAX=100
# BID_SEQUENCER=true
# BID_STREAM_BACKPRESSURE=750

# ------------------------------------------------------------------------------
# 2. FRONTEND APP (front/.env)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
# NEXT_PUBLIC_WS_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 3. SIMULATOR PACKAGE (packages/simulator/.env)
# ------------------------------------------------------------------------------
# SIM_BACKEND_URL=http://localhost:5000/api
# SIM_DURATION=60
# SIM_PRIMARY_AUCTIONS=3
