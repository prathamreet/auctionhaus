// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum AuctionType {
  ENGLISH
  DUTCH
  SEALED_BID
}

enum AuctionStatus {
  PENDING    // not started yet
  ACTIVE     // accepting bids
  ENDED      // ended naturally or manually
  CANCELLED  // cancelled by seller or admin
}

enum BidStatus {
  ACTIVE
  OUTBID
  WINNING
  WON
  LOST
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BID_HOLD
  BID_RELEASE
  PAYMENT
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum NotificationType {
  OUTBID
  AUCTION_WON
  AUCTION_LOST
  AUCTION_STARTED
  AUCTION_ENDED
  AUTO_BID_PLACED
  PAYMENT_RECEIVED
  GENERAL
}

// Phase A5: how a settlement's money moved. DIRECT_SALE = buyNow (buyer
// balance -> seller balance). WON_AUCTION = confirmWinnerPayment (winner
// heldAmount -> seller balance; the balance was already debited at bid time).
enum SettlementKind {
  DIRECT_SALE
  WON_AUCTION
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String?  // null if OAuth
  name          String
  avatar        String?
  role          Role     @default(USER)
  rating        Float    @default(0)
  ratingCount   Int      @default(0)
  isSuspended   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  wallet        Wallet?
  auctions      Auction[]         @relation("SellerAuctions")
  wonAuctions   Auction[]         @relation("WinnerAuctions")
  bids          Bid[]
  autoBids      AutoBid[]
  notifications Notification[]
  watchlist     WatchlistItem[]
  transactions  Transaction[]
  sentRatings   Rating[]          @relation("RaterRatings")
  receivedRatings Rating[]        @relation("RateeRatings")

  @@map("users")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  // Phase A1: money is exact -- NUMERIC(18,2) in Postgres, Prisma.Decimal in JS.
  // Float would lose precision under repeated holds / releases.
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  heldAmount Decimal @default(0) @db.Decimal(18, 2) // locked for active bids
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id          String            @id @default(uuid())
  walletId    String
  userId      String
  type        TransactionType
  // Phase A1: signed amount (negative for debits like WITHDRAWAL, PAYMENT_OUT).
  amount      Decimal           @db.Decimal(18, 2)
  status      TransactionStatus @default(COMPLETED)
  description String?
  referenceId String?           // auctionId or bidId
  createdAt   DateTime          @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  // Phase A3: wallet history page. The DESC ordering on createdAt is enforced
  // by the raw-SQL index in 20260528000001_perf_indexes; Prisma schema can't
  // declare a per-column direction, so @@index without it is still correct
  // (Postgres scans the B-tree backwards for DESC) -- the raw form just
  // helps when the planner is uncertain.
  @@index([userId, createdAt])
  @@map("transactions")
}

model Auction {
  id              String        @id @default(uuid())
  sellerId        String
  title           String
  description     String
  imageUrl        String?
  type            AuctionType   @default(ENGLISH)
  status          AuctionStatus @default(PENDING)

  // Pricing (Phase A1: Decimal for exact arithmetic)
  startingPrice   Decimal       @db.Decimal(18, 2)
  reservePrice    Decimal?      @db.Decimal(18, 2) // minimum to sell
  currentPrice    Decimal       @db.Decimal(18, 2)
  buyNowPrice     Decimal?      @db.Decimal(18, 2) // instant buy option

  // Dutch auction specific
  dutchPriceStep  Decimal?      @db.Decimal(18, 2) // price drops by this per interval
  dutchInterval   Int?          // seconds between price drops

  // Bidding rules
  minIncrement    Decimal       @default(1) @db.Decimal(18, 2)
  antiSnipingMins Int           @default(5) // extend by X mins if bid in last X mins

  // Timing
  startTime       DateTime
  endTime         DateTime
  actualEndTime   DateTime?     // if extended due to anti-sniping

  // Winner
  winnerId        String?
  winnerBidId     String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  seller     User           @relation("SellerAuctions", fields: [sellerId], references: [id])
  winner     User?          @relation("WinnerAuctions", fields: [winnerId], references: [id])
  bids       Bid[]
  autoBids   AutoBid[]
  watchlist  WatchlistItem[]

  // Phase A3: catalog read paths. The GIN tsvector(title + description) FTS
  // index is in raw SQL only -- Prisma cannot express it -- see the migration
  // 20260528000001_perf_indexes/migration.sql.
  @@index([status])
  @@index([endTime])
  @@index([type, status])
  @@map("auctions")
}

model Bid {
  id        String    @id @default(uuid())
  auctionId String
  bidderId  String
  amount    Decimal   @db.Decimal(18, 2)
  status    BidStatus @default(ACTIVE)
  isAutoBid Boolean   @default(false)
  createdAt DateTime  @default(now())

  auction Auction @relation(fields: [auctionId], references: [id])
  bidder  User    @relation(fields: [bidderId], references: [id])

  // Phase A3: getAuctionBids + placeBid previous-winner lookup + bid history.
  @@index([auctionId, status])
  @@index([bidderId])
  @@map("bids")
}

model AutoBid {
  id         String   @id @default(uuid())
  auctionId  String
  bidderId   String
  maxAmount  Decimal  @db.Decimal(18, 2) // max they're willing to bid
  currentBid Decimal  @default(0) @db.Decimal(18, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  auction Auction @relation(fields: [auctionId], references: [id])
  bidder  User    @relation(fields: [bidderId], references: [id])

  @@unique([auctionId, bidderId])
  @@map("auto_bids")
}

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  auctionId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([userId, auctionId])
  @@map("watchlist_items")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  data      Json?            // extra payload (auctionId, amount, etc.)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Phase A3: notifications inbox query.
  @@index([userId, isRead])
  @@map("notifications")
}

model Rating {
  id         String   @id @default(uuid())
  raterId    String
  rateeId    String
  auctionId  String
  score      Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  rater User @relation("RaterRatings", fields: [raterId], references: [id])
  ratee User @relation("RateeRatings", fields: [rateeId], references: [id])

  @@unique([raterId, rateeId, auctionId])
  @@map("ratings")
}

// Phase A5: single source of truth that an auction's money has settled. One
// row per auction (auctionId @unique) is the idempotency guard shared by
// buyNow (DIRECT_SALE) and confirmWinnerPayment (WON_AUCTION) -- whichever
// path runs first inserts the row inside its locked tx; a concurrent or
// retried second call sees the row and no-ops instead of moving money twice.
// Scalar-only by design: this is an append-only audit/guard table we never
// navigate from in code, so no Prisma relations (keeps the migration to one
// table + one unique index, matching the hand-written SQL exactly).
model Settlement {
  id        String         @id @default(uuid())
  auctionId String         @unique
  sellerId  String
  partyId   String         // buyer (DIRECT_SALE) or winner (WON_AUCTION)
  amount    Decimal        @db.Decimal(18, 2)
  kind      SettlementKind
  createdAt DateTime       @default(now())

  @@map("settlements")
}
