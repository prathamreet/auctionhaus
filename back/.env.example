# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/auctionhaus"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting (Optional overrides, defaults: 1000, 100)
# RATE_LIMIT_MAX=1000
# RATE_LIMIT_STRICT_MAX=100

# Bid Sequencer (Optional, Redis Stream based)
# BID_SEQUENCER=true
# BID_STREAM_BACKPRESSURE=750

