{
  "name": "back",
  "version": "1.0.0",
  "description": "AuctionHaus Backend - Real-Time Auction Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:clear-auctions": "ts-node src/scripts/clear-auctions.ts",
    "db:clear-users": "ts-node src/scripts/clear-users.ts",
    "db:seed-users": "ts-node src/scripts/seed-users.ts",
    "db:prepare-bench": "ts-node src/scripts/prepare-bench.ts",
    "docs:generate": "ts-node src/scripts/generate-docs.ts",
    "sim:run": "ts-node ../packages/simulator/src/run.ts",
    "train:fraud": "ts-node ../packages/simulator/src/train.ts",
    "train:fraud:v2": "ts-node ../packages/simulator/src/train.v2.ts",
    "eval:fraud": "ts-node ../packages/simulator/src/eval.ts",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.4.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.28",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.59.1"
  }
}
