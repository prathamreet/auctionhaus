# API URL for the backend
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# WebSocket URL for the backend
NEXT_PUBLIC_WS_URL=http://localhost:5000

# Cloudinary unsigned image uploads (optional). Enables the file-upload control
# on the create-auction and profile forms; without these the forms fall back to
# pasting an image URL. Create a free Cloudinary account, then add an UNSIGNED
# upload preset under Settings > Upload, and put its name below.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
